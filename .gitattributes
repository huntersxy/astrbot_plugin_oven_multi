# Auto detect text files and perform LF normalization
* text=auto

# Force LF for source files
*.py text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary

# Exclude from release zip (git archive)
.trae/ export-ignore
参考资料/ export-ignore
tests/ export-ignore
plugin_data/** export-ignore
data/** export-ignore
**/cookies.json export-ignore
**/douyin_cookie.txt export-ignore
**/subscriptions.json export-ignore
**/billion-context.json export-ignore
